#Область ПрограммныйИнтерфейс

Процедура ДополнитьФорму(Форма) Экспорт
	
	ИмяФормы = Форма.ИмяФормы;
	
	Если ИмяФормы = "Документ.ЗаказПокупателя.Форма.ФормаДокумента" Тогда
		
		ДобавитьПолеКонтактноеЛицо(Форма);
		ДобавитьСогласованнуюСкидку(Форма);
		
	ИначеЕсли ИмяФормы = "Документ.ПоступлениеТоваровУслуг.Форма.ФормаДокумента"
		Или ИмяФормы = "Документ.РеализацияТоваровУслуг.Форма.ФормаДокумента" Тогда
		
		ДобавитьПолеКонтактноеЛицо(Форма);
		
	ИначеЕсли ИмяФормы = "Документ.ОплатаОтПокупателя.Форма.ФормаДокумента"
		Или ИмяФормы = "Документ.ОплатаПоставщику.Форма.ФормаДокумента" Тогда
		
		ВставитьПолеКонтактноеЛицоПередСуммойДокумента(Форма);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьПолеКонтактноеЛицо(Форма)
	
	ПолеВвода = Форма.Элементы.Добавить("УЧ_КонтактноеЛицо", Тип("ПолеФормы"),
		Форма.Элементы.ГруппаШапкаЛево);
	ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
	ПолеВвода.ПутьКДанным = "Объект.УЧ_КонтактноеЛицо";
	
КонецПроцедуры

Процедура ВставитьПолеКонтактноеЛицоПередСуммойДокумента(Форма)
	
	ПолеВвода = Форма.Элементы.Вставить("УЧ_КонтактноеЛицо", Тип("ПолеФормы"), ,
		Форма.Элементы.СуммаДокумента);
	ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
	ПолеВвода.ПутьКДанным = "Объект.УЧ_КонтактноеЛицо";
	
КонецПроцедуры

#КонецОбласти

Процедура ДобавитьСогласованнуюСкидку(Форма)
	
	ГруппаСкидка = Форма.Элементы.Добавить("УЧ_ГруппаСкидка", Тип("ГруппаФормы"),
		Форма.Элементы.ГруппаШапкаЛево);
	ГруппаСкидка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаСкидка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	ГруппаСкидка.ОтображатьЗаголовок = Ложь;
	
	ПолеСкидка = Форма.Элементы.Добавить("УЧ_СогласованнаяСкидка", Тип("ПолеФормы"), ГруппаСкидка);
	ПолеСкидка.Вид = ВидПоляФормы.ПолеВвода;
	ПолеСкидка.ПутьКДанным = "Объект.УЧ_СогласованнаяСкидка";
	ПолеСкидка.УстановитьДействие("ПриИзменении", "УЧ_СогласованнаяСкидкаПриИзменении");
	
	Команда = Форма.Команды.Добавить("УЧ_Пересчитать");
	Команда.Действие = "УЧ_Пересчитать";
	Команда.Заголовок = "Пересчитать";
	
	Кнопка = Форма.Элементы.Добавить("УЧ_Пересчитать", Тип("КнопкаФормы"), ГруппаСкидка);
	Кнопка.ИмяКоманды = "УЧ_Пересчитать";
	
КонецПроцедуры